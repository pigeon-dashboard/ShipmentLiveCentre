{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "*.{png,jpg,gif,ico,css,js,svg,woff,woff2}"]
  },
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "globalHeaders": {
    "Cache-Control": "no-store",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "responseOverrides": {
    "401": { "statusCode": 200, "rewrite": "/index.html" },
    "404": { "statusCode": 200, "rewrite": "/index.html" }
  },
  "platform": {
    "apiRuntime": "node:18"
  }
}
